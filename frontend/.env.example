VITE_API_URL=http://localhost:8000

# WS latency ACK — set true to record ws_received_at on all log tables.
# Keep false in normal ops to avoid extra DB UPDATE load.
# Set true only for E2E / latency testing builds.
VITE_ENABLE_WS_LATENCY_ACK=false

# LEGACY / UNUSED — kept only for backwards compatibility, not read by the app anymore.
# OpenWeatherMap, Google Maps, and Mapbox keys are now configured at runtime by an admin
# via the System Management page (stored in the system_settings DB table), not via env vars.
# VITE_OPENWEATHER_API_KEY=your_openweathermap_api_key_here
# VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
# VITE_MAPBOX_TOKEN=your_mapbox_access_token_here

# LEGACY / UNUSED — real-time mode is hardcoded to MQTT in the app; kept only for reference.
# VITE_REALTIME_MODE=mqtt
# VITE_REALTIME_POLL_INTERVAL_MS=5000

# MQTT Configuration
VITE_MQTT_BROKER=your_mqtt_broker_host
VITE_MQTT_PORT=8884
VITE_MQTT_USERNAME=your_mqtt_username
VITE_MQTT_PASSWORD=your_mqtt_password
