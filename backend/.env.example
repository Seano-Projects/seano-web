# Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_USER=appuser
DB_PASSWORD=apppass
DB_NAME=appdb

# JWT Configuration
JWT_SECRET=your-secret-key-change-in-production
REFRESH_SECRET=your-refresh-secret-change-in-production
WS_TOKEN_SECRET=your-websocket-secret-change-in-production
COOKIE_SECURE=false

# SMTP Configuration (Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM=your-email@gmail.com

# Timezone
TZ=Asia/Jakarta

# OpenRouter AI Configuration
OPENROUTER_API_KEY=your-openrouter-api-key-here

# MQTT Configuration
MQTT_BROKER=your-mqtt-broker-host
MQTT_PORT=1883
MQTT_USERNAME=your-mqtt-username
MQTT_PASSWORD=your-mqtt-password
MQTT_CLIENT_ID=go-fiber-server
MQTT_TOPIC_PREFIX=seano
REALTIME_MODE=mqtt

# MQTT TLS / Transport Configuration
#
# MQTT_PROTOCOL overrides MQTT_USE_TLS jika di-set.
# Nilai yang valid: tcp | ssl | ws | wss
#
# --- Opsi A: Via Nginx Proxy Manager (REKOMENDASI) ---
# NPM sudah handle TLS (Let's Encrypt). Backend konek lewat wss:// seperti frontend.
# Tidak perlu konfigurasi TLS di Mosquitto sama sekali.
#
#   MQTT_PROTOCOL=wss
#   MQTT_BROKER=mqtt.seano.cloud
#   MQTT_PORT=443
#   MQTT_PATH=/mqtt
#   MQTT_TLS_INSECURE=false
#
# --- Opsi B: TLS langsung ke Mosquitto port 8883 (Let's Encrypt) ---
#
#   MQTT_PROTOCOL=ssl
#   MQTT_BROKER=mqtt.seano.cloud
#   MQTT_PORT=8883
#   MQTT_PATH=
#   MQTT_TLS_INSECURE=false
#   MQTT_CA_CERT_PATH=        # kosong = pakai system CA
#
# --- Opsi C: TLS langsung ke Mosquitto port 8883 (self-signed cert) ---
#
#   MQTT_PROTOCOL=ssl
#   MQTT_BROKER=mqtt.seano.cloud
#   MQTT_PORT=8883
#   MQTT_TLS_INSECURE=false
#   MQTT_CA_CERT_PATH=/etc/ssl/seano/ca.crt
#
# --- Opsi D: Tanpa TLS (development lokal saja) ---
#
#   MQTT_PROTOCOL=tcp
#   MQTT_BROKER=localhost
#   MQTT_PORT=1883
#
MQTT_USE_TLS=false
MQTT_PROTOCOL=
MQTT_PATH=
MQTT_TLS_INSECURE=false
MQTT_CA_CERT_PATH=
